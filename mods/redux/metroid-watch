#!/usr/bin/env bash
# metroid-watch - has Metroid Redux gained an automap?
#
# A Metroid Remuxed waits on Metroid Redux porting an automap (see
# notes/metrandomizer-on-reason in the vault). This fetches upstream Metroid
# Redux and reports through ntfy-post only when something changed: new
# commits, or automap code appearing. There is nothing to build yet, so unlike
# upstream-check this only reads the source.
#
#   metroid-watch            check now, notify on change
#   metroid-watch -n         check now, print only (no ntfy, state unchanged)
set -uo pipefail

REPO=https://github.com/ShadowOne333/Metroid-Redux
# The commit measured on 2026-10-14: Metroid + Saving's minimap only; main.asm
# marks the saving include "Missing Automap".
BASE=dd40ab7d65ecf96eddda9fbfc7acd25ecf0cd3a1
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/zelda-remuxed/metroid-redux
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/zelda-remuxed

dry=0
[[ ${1:-} == -n ]] && dry=1

notify() {   # title, priority, message
    if (( dry )); then printf '%s\n%s\n' "$1" "$3"; else ntfy-post -t "$1" -p "$2" -g metroid alerts "$3"; fi
}

mkdir -p "$STATE" "$(dirname "$CACHE")"
if [[ -d $CACHE/.git ]]; then
    git -C "$CACHE" fetch -q origin || { notify "Metroid Redux watch" default "git fetch failed"; exit 1; }
    git -C "$CACHE" reset -q --hard origin/HEAD
else
    git clone -q "$REPO" "$CACHE" || { notify "Metroid Redux watch" default "git clone failed"; exit 1; }
fi
head=$(git -C "$CACHE" rev-parse HEAD)
date=$(git -C "$CACHE" log -1 --format=%cs)
since=$(git -C "$CACHE" rev-list --count "$BASE..$head" 2>/dev/null || echo "?")

# Automap code: a map file added since BASE (Metroid + Saving's minimap files
# were already there), or any mention of an automap other than the
# placeholders that were there at BASE.
hits=$( { git -C "$CACHE" diff --name-only --diff-filter=A "$BASE" HEAD -- code | grep -i 'map' | sed 's|^code/||'
          grep -rIil 'automap' "$CACHE/code" | while read -r f; do
              grep -iI 'automap' "$f" | grep -viqE 'missing automap|add automap' && printf '%s\n' "${f#"$CACHE"/code/}"
          done; } | sort -u )
if [[ -n $hits ]]; then automap=found; else automap=none; fi

msg="Metroid Redux ${head:0:7} ($date), $since commit(s) since the 2026-10-14 measurement; automap: $automap"
[[ -n $hits ]] && msg+=$'\n'"$(printf '%s\n' "$hits" | head -8)"

key="$head $automap"
last=$(cat "$STATE/metroid-watch" 2>/dev/null || true)
if (( dry )); then
    printf '%s\n' "$msg"
elif [[ $key != "$last" && $since != 0 ]]; then
    if [[ $automap == found ]]; then
        notify "Metroid Redux: automap code appeared" high "$msg"$'\n'"Re-run the measurement pass before starting Metroid Remuxed."
    else
        notify "Metroid Redux: new commits" min "$msg"
    fi
    printf '%s\n' "$key" > "$STATE/metroid-watch"
else
    printf '%s\n' "$key" > "$STATE/metroid-watch"
fi
